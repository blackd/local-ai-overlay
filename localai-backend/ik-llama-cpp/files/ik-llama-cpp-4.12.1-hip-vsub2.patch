IQ5_KS_R16 (ik_llama.cpp #2703) uses CUDA's __vsub2, which HIP has no
counterpart for and vendors/hip.h does not define; the HIP build fails
in mmvq-instance-iq5_ks_r16.cu. Add it beside the other emulated
vector intrinsics: two independent 16-bit lanes, wrapping like CUDA.

--- a/ggml/src/ggml-cuda/vendors/hip.h
+++ b/ggml/src/ggml-cuda/vendors/hip.h
@@ -196,6 +196,12 @@
     return result_low_7bits ^ should_flip_high_1bit;
 }
 
+static __device__ __forceinline__ unsigned int __vsub2(const unsigned int a, const unsigned int b) {
+    const unsigned int lo = (a - b) & 0x0000ffffu;
+    const unsigned int hi = ((a & 0xffff0000u) - (b & 0xffff0000u)) & 0xffff0000u;
+    return hi | lo;
+}
