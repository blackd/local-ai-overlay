--- a/device_dedup.h	1970-01-01 00:00:00.000000000 -0000
+++ b/device_dedup.h	1970-01-01 00:00:00.000000000 -0000
@@ -0,0 +1,83 @@
+#pragma once
+// Default-device deduplication for multi-accelerator builds: the same
+// physical GPU registers once per compiled ggml backend (e.g. ROCm0 and
+// Vulkan0 both naming one card), and with no device selection llama.cpp
+// books memory for every view. Identity is the PCI bus id ggml reports
+// per device. Standard library only: compiled and tested without an
+// engine checkout.
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace llama_grpc {
+
+enum class DevKind { GPU, ACCEL, CPU };
+
+struct DeviceInfo {
+    std::string name;      // registry name, e.g. "ROCm0", "Vulkan1"
+    std::string device_id; // PCI bus id; empty when unknown
+    DevKind kind;
+};
+
+// Native backends outrank the portability layers when both expose the
+// same physical device; an unrecognized backend ranks between the two.
+inline int device_backend_rank(const std::string & name) {
+    static const char * native[] = { "CUDA", "ROCm", "HIP", "SYCL", "Metal" };
+    for (size_t i = 0; i < sizeof(native) / sizeof(*native); i++) {
+        if (name.rfind(native[i], 0) == 0) {
+            return (int) i;
+        }
+    }
+    if (name.rfind("Vulkan", 0) == 0) return 100;
+    if (name.rfind("OpenCL", 0) == 0) return 101;
+    return 50;
+}
+
+// Returns the device names to offload to when the user selected none:
+// for every group of GPU devices sharing a PCI bus id, all but the
+// preferred backend's view are dropped. GPUs with unknown identity are
+// kept, ACCEL devices are kept, CPU is never listed (it is the host
+// fallback, not an offload target). Returns an empty vector when no
+// duplicate exists — the caller then leaves the default behavior
+// untouched.
+inline std::vector<std::string> dedup_default_devices(const std::vector<DeviceInfo> & devices) {
+    std::map<std::string, const DeviceInfo *> best;
+    bool duplicate = false;
+    for (const auto & d : devices) {
+        if (d.kind != DevKind::GPU || d.device_id.empty()) {
+            continue;
+        }
+        auto it = best.find(d.device_id);
+        if (it == best.end()) {
+            best.emplace(d.device_id, &d);
+        } else {
+            duplicate = true;
+            if (device_backend_rank(d.name) < device_backend_rank(it->second->name)) {
+                it->second = &d;
+            }
+        }
+    }
+    if (!duplicate) {
+        return {};
+    }
+
+    std::vector<std::string> keep;
+    for (const auto & d : devices) {
+        switch (d.kind) {
+        case DevKind::CPU:
+            continue;
+        case DevKind::ACCEL:
+            keep.push_back(d.name);
+            continue;
+        case DevKind::GPU:
+            if (!d.device_id.empty() && best.at(d.device_id)->name != d.name) {
+                continue; // a duplicate view of a device kept under another backend
+            }
+            keep.push_back(d.name);
+        }
+    }
+    return keep;
+}
+
+} // namespace llama_grpc
--- a/device_dedup_test.cpp	1970-01-01 00:00:00.000000000 -0000
+++ b/device_dedup_test.cpp	1970-01-01 00:00:00.000000000 -0000
@@ -0,0 +1,72 @@
+#include "device_dedup.h"
+
+#include <cstdio>
+
+using llama_grpc::DevKind;
+using llama_grpc::DeviceInfo;
+using llama_grpc::dedup_default_devices;
+
+int main() {
+    // Same card via ROCm and Vulkan: the Vulkan view is dropped.
+    {
+        auto keep = dedup_default_devices({
+            { "ROCm0", "0000:c1:00.0", DevKind::GPU },
+            { "Vulkan0", "0000:c1:00.0", DevKind::GPU },
+        });
+        if (keep != std::vector<std::string>{ "ROCm0" }) {
+            std::fprintf(stderr, "single-card dedup did not keep the native view\n");
+            return 1;
+        }
+    }
+    // Twin cards: each pair dedups to its own native view.
+    {
+        auto keep = dedup_default_devices({
+            { "ROCm0", "0000:c1:00.0", DevKind::GPU },
+            { "ROCm1", "0000:c2:00.0", DevKind::GPU },
+            { "Vulkan0", "0000:c1:00.0", DevKind::GPU },
+            { "Vulkan1", "0000:c2:00.0", DevKind::GPU },
+        });
+        if (keep != (std::vector<std::string>{ "ROCm0", "ROCm1" })) {
+            std::fprintf(stderr, "twin-card dedup paired the views wrongly\n");
+            return 1;
+        }
+    }
+    // A genuine Vulkan-only card participates alongside the deduped one.
+    {
+        auto keep = dedup_default_devices({
+            { "ROCm0", "0000:c1:00.0", DevKind::GPU },
+            { "Vulkan0", "0000:c1:00.0", DevKind::GPU },
+            { "Vulkan1", "0000:03:00.0", DevKind::GPU },
+        });
+        if (keep != (std::vector<std::string>{ "ROCm0", "Vulkan1" })) {
+            std::fprintf(stderr, "vulkan-only card was not kept\n");
+            return 1;
+        }
+    }
+    // Unknown identity is never dropped; ACCEL kept; CPU never listed.
+    {
+        auto keep = dedup_default_devices({
+            { "ROCm0", "0000:c1:00.0", DevKind::GPU },
+            { "Vulkan0", "0000:c1:00.0", DevKind::GPU },
+            { "Vulkan1", "", DevKind::GPU },
+            { "BLAS", "", DevKind::ACCEL },
+            { "CPU", "", DevKind::CPU },
+        });
+        if (keep != (std::vector<std::string>{ "ROCm0", "Vulkan1", "BLAS" })) {
+            std::fprintf(stderr, "unknown-id/accel/cpu handling wrong\n");
+            return 1;
+        }
+    }
+    // No duplicates: empty result, caller keeps the default behavior.
+    {
+        auto keep = dedup_default_devices({
+            { "ROCm0", "0000:c1:00.0", DevKind::GPU },
+            { "CPU", "", DevKind::CPU },
+        });
+        if (!keep.empty()) {
+            std::fprintf(stderr, "dedup fired without duplicates\n");
+            return 1;
+        }
+    }
+    return 0;
+}
