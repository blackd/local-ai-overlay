+    // Multi-accelerator builds register the same physical GPU once per
+    // compiled backend; with no device selection llama.cpp books memory
+    // for every view of the card. Drop duplicate views by PCI bus id,
+    // preferring the native backend. Single-BUILD_TYPE images register
+    // one view per card and are unaffected. An explicit device: option
+    // or LLAMA_ARG_DEVICE wins by running before this and filling
+    // params.devices.
+    if (params.devices.empty()) {
+        std::vector<llama_grpc::DeviceInfo> devs;
+        for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            ggml_backend_dev_props props;
+            ggml_backend_dev_get_props(dev, &props);
+            llama_grpc::DevKind kind = llama_grpc::DevKind::CPU;
+            if (props.type == GGML_BACKEND_DEVICE_TYPE_GPU ||
+            props.type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+                kind = llama_grpc::DevKind::GPU;
+            } else if (props.type == GGML_BACKEND_DEVICE_TYPE_ACCEL) {
+                kind = llama_grpc::DevKind::ACCEL;
+            }
+            devs.push_back({
+                props.name ? props.name : "",
+                props.device_id ? props.device_id : "",
+                kind,
+            });
+        }
+        const auto keep = llama_grpc::dedup_default_devices(devs);
+        if (!keep.empty()) {
+            auto kept = [&keep](const std::string & name) {
+                for (const auto & k : keep) {
+                    if (k == name) return true;
+                }
+                return false;
+            };
+            for (const auto & name : keep) {
+                if (ggml_backend_dev_t dev = ggml_backend_dev_by_name(name.c_str())) {
+                    params.devices.push_back(dev);
+                }
+            }
+            if (!params.devices.empty()) {
+                // llama_prepare_model_devices iterates until nullptr; the
+                // terminator is part of the devices-list format (see
+                // parse_device_list in common/arg.cpp).
+                params.devices.push_back(nullptr);
+            }
+            for (const auto & d : devs) {
+                if (d.kind == llama_grpc::DevKind::GPU && !kept(d.name)) {
+                    fprintf(stderr,
+                        "[llama-cpp] device %s is another backend's view of PCI %s, not using it (set the device: option to override)\n",
+                        d.name.c_str(), d.device_id.c_str());
+                }
+            }
+        }
+    }
+
