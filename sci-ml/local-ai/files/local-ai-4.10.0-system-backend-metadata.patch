+// collectBackendDir gathers one backend directory into the listing: its
+// concrete entry (when run.sh exists), its alias candidacy and its meta
+// indirection, all driven by the directory's optional metadata.json.
+// Shared by the system and user-managed scans.
+func collectBackendDir(basePath, dir string, isSystem bool, backends SystemBackends, aliasGroups map[string][]backendCandidate, metaMap map[string]*BackendMetadata) error {
+	run := filepath.Join(basePath, dir, runFile)
+
+	metadata := &BackendMetadata{Name: dir}
+	if _, err := os.Stat(filepath.Join(basePath, dir, metadataFile)); err == nil {
+		m, rerr := readBackendMetadata(filepath.Join(basePath, dir))
+		if rerr != nil {
+			return rerr
+		}
+		if m != nil {
+			metadata = m
+		}
+	}
+
+	metaMap[dir] = metadata
+
+	// Concrete-backend entry
+	if _, err := os.Stat(run); err == nil {
+		backends[dir] = SystemBackend{
+			Name:     dir,
+			RunFile:  run,
+			IsMeta:   false,
+			IsSystem: isSystem,
+			Metadata: metadata,
+		}
+	}
+
+	// Alias candidates
+	if metadata.Alias != "" {
+		aliasGroups[metadata.Alias] = append(aliasGroups[metadata.Alias], backendCandidate{name: dir, runFile: run})
+	}
+
+	// Meta backends indirection
+	if metadata.MetaBackendFor != "" {
+		backends[metadata.Name] = SystemBackend{
+			Name:     metadata.Name,
+			RunFile:  filepath.Join(basePath, metadata.MetaBackendFor, runFile),
+			IsMeta:   true,
+			IsSystem: isSystem,
+			Metadata: metadata,
+		}
+	}
+	return nil
+}
