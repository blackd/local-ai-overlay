+			if err != nil {
+				return err
+			}
+			if opcache != nil {
+				opcache.Set(modelConfig.Name, jobUUID.String())
+			}
+			gs.EnqueueModelOp(galleryop.ManagementOp[gallery.GalleryModel, gallery.ModelConfig]{
+				Req:                gallery.GalleryModel{Overrides: map[string]any{}},
